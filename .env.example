# Get all the proper credentials from the Supabase website.

SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Key required by the secretariat admin page (pages/admin.html).
# Use a long random value; anyone with this key can see members and verify payments.
ADMIN_KEY=""

# ── Registration confirmation email ────────────────────────────
# Optional: when no mail provider is configured, registrations still
# succeed and the server logs that no email was sent.
#
# Option 1 (recommended on Render): Resend HTTP API — no SMTP ports needed.
#   1. Create a free account at https://resend.com and copy an API key.
#   2. Put the key below and set MAIL_FROM to a verified sender/domain.
RESEND_API_KEY=""

# Option 2: SMTP (Gmail, Zoho, SendGrid SMTP, your own mail server).
#   Gmail:    smtp.gmail.com / port 587 / use an App Password for SMTP_PASS
#   Zoho:     smtp.zoho.com / port 587
#   SendGrid: smtp.sendgrid.net / port 587 / SMTP_USER "apikey" / SMTP_PASS your API key
# RESEND_API_KEY takes precedence when both are set.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# From header shown to members. Leave empty to fall back to SMTP_USER
# (or onboarding@resend.dev when using Resend).
MAIL_FROM=""

# Optional public URL of the site, used for the login button in the email.
# Example: https://your-site.example.com
PUBLIC_SITE_URL=""
